# Environment Variables Template for DBUFF Application
# Copy this file to .env and set your actual API keys

# Scrapper API Key (ScraperAPI)
# Get your key from: https://www.scraperapi.com/
# Set scrapper.enabled=false in application.properties to disable scraping entirely
# Set scrapper.provider to choose provider (default: scraperapi)
SCRAPPER_API_KEY=your_scrapper_api_key_here

# Dota API Key (OpenDota API)
# Get your key from: https://www.opendota.com/api-keys
DOTA_API_KEY=your_dota_api_key_here

# OpenAI API Key (for AI-based match analysis)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Discord Bot Token
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Google Cloud Vision (OCR) service-account JSON key.
# Either set GOOGLE_APPLICATION_CREDENTIALS (Application Default Credentials) OR
# set GOOGLE_VISION_CREDENTIALS_PATH to the path of the service-account JSON key.
#GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/google-vision-service-account.json
#GOOGLE_VISION_CREDENTIALS_PATH=/absolute/path/to/google-vision-service-account.json

# --- AWS Deployment (used by infrastructure/cloudformation/deploy.sh) ---

# EC2 key pair name (create via: aws ec2 create-key-pair --key-name dbuff-key)
KEY_PAIR_NAME=dbuff-key

# Password for the 'dbuffuser' role in the PostgreSQL instance running on the app
# server (min 8 characters). Must NOT contain a single quote - it is interpolated
# into a SQL literal in the instance UserData.
DB_PASSWORD=your_db_password_here

# AWS region (default: eu-north-1)
#AWS_REGION=eu-north-1

# Do NOT put AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY here. deploy.sh exports
# every variable in this file, and exported AWS_* vars take precedence over
# ~/.aws/credentials - so a stale key here silently shadows your real one and the
# deploy fails with InvalidClientTokenId. Let the AWS CLI resolve credentials.

# EC2 instance type, arm64/Graviton only (default: t4g.small)
#INSTANCE_TYPE=t4g.small

# CIDR for SSH access (default: 0.0.0.0/0, restrict to your IP for security)
#ALLOWED_SSH_CIDR=0.0.0.0/0